&pinctrl {
    i2c21_default: i2c21_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
                    <NRF_PSEL(TWIM_SCL, 1, 11)>;
        };
    };

    i2c21_sleep: i2c21_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
                    <NRF_PSEL(TWIM_SCL, 1, 11)>;
            low-power-enable;
        };
    };
};

&i2c21 {
    status = "okay";
    pinctrl-0 = <&i2c21_default>;
    pinctrl-1 = <&i2c21_sleep>;
    pinctrl-names = "default", "sleep";

    max30102: max30102@57 {
        compatible = "maxim,max30102", "maxim,max30101";
        reg = <0x57>;

        acq-mode = "spo2";

        led-pa = [ 24 24 00 ];

        smp-ave = <4>;
        smp-sr = <100>;
        adc-rge = <16384>;
        led-pw = <411>;
    };
};
